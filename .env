# ============================================================
# PORTAIL REPORTING PBIRS BICEC — Configuration Intranet
# ============================================================

# --- Power BI Report Server (PBIRS) ---
# URL de base du portail Web PBIRS (ex: http://SERVEUR/Reports)
PBIRS_SERVER_URL=http://desktop-ij1n97v/Reports

# URL de l'API REST PBIRS v2.0
PBIRS_API_URL=http://desktop-ij1n97v/Reports/api/v2.0

# Mettre à False pour se connecter au vrai PBIRS
PBIRS_MOCK_MODE=True

# --- Active Directory (optionnel au départ) ---
AD_DOMAIN=bicec.local
AD_LDAP_SERVER=ldap://dc01.bicec.local
AD_ENABLE_DEV_MOCK=true   # garde true tant que l'AD n'est pas configuré

# --- Sécurité ---
SECRET_KEY=change-cette-cle-secrete-en-production-bicec-2026
